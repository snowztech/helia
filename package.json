{
  "name": "helia",
  "version": "0.1.3",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter @helia/api --filter @helia/web --filter @gethelia/widget dev",
    "dev:api": "pnpm --filter @helia/api dev",
    "dev:web": "pnpm --filter @helia/web dev",
    "dev:widget": "pnpm --filter @gethelia/widget dev",
    "dev:landing": "pnpm --filter @helia/landing dev",
    "build": "pnpm -r build",
    "sdk:check": "pnpm --filter @gethelia/widget typecheck && pnpm --filter @gethelia/server typecheck && pnpm --filter @gethelia/react typecheck && pnpm --filter @gethelia/widget build && pnpm --filter @gethelia/server build && pnpm --filter @gethelia/react build",
    "sdk:pack": "pnpm --filter @gethelia/widget pack && pnpm --filter @gethelia/server pack && pnpm --filter @gethelia/react pack",
    "rag:eval": "pnpm --filter @helia/rag eval",
    "release:app": "node scripts/release-app.mjs",
    "release:sdk": "node scripts/release-sdk.mjs",
    "start:api": "pnpm --filter @helia/api start",
    "start:web": "pnpm --filter @helia/web start",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @helia/api db:generate",
    "db:migrate": "pnpm --filter @helia/api db:migrate",
    "db:studio": "pnpm --filter @helia/api db:studio"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.0.0"
  }
}
