{
  "name": "@gethelia/react",
  "version": "0.0.3",
  "description": "React wrapper for the Helia widget.",
  "license": "AGPL-3.0-only",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/snowztech/helia.git",
    "directory": "packages/react"
  },
  "homepage": "https://gethelia.dev/docs",
  "bugs": {
    "url": "https://github.com/snowztech/helia/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm --filter @gethelia/widget build && tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "typecheck": "pnpm --filter @gethelia/widget build && tsc --noEmit"
  },
  "dependencies": {
    "@gethelia/widget": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "19.0.0",
    "typescript": "^5.7.0"
  }
}
