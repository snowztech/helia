{
  "name": "@gethelia/server",
  "version": "0.0.2",
  "description": "Server helpers for signing Helia end-user identity.",
  "license": "AGPL-3.0-only",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/snowztech/helia.git",
    "directory": "packages/server"
  },
  "homepage": "https://gethelia.dev/docs",
  "bugs": {
    "url": "https://github.com/snowztech/helia/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
