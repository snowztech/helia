{
  "name": "@gethelia/widget",
  "version": "0.0.2",
  "description": "Helia widget runtime for script tag and vanilla embeds.",
  "license": "AGPL-3.0-only",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/snowztech/helia.git",
    "directory": "packages/widget"
  },
  "homepage": "https://gethelia.dev/docs",
  "bugs": {
    "url": "https://github.com/snowztech/helia/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && esbuild src/loader.ts --bundle --format=iife --global-name=Helia --outfile=dist/w.js --minify --target=es2020 --sourcemap",
    "prepack": "pnpm run build",
    "dev": "esbuild src/loader.ts --bundle --format=iife --global-name=Helia --outfile=dist/w.js --target=es2020 --sourcemap --servedir=. --serve=localhost:5173",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "typescript": "^5.7.0"
  }
}
